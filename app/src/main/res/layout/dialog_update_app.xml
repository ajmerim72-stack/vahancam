<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#1E293B">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_system_update"
            app:tint="#10B981"
            android:layout_marginEnd="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Update VahanCam App"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvUpdateDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Current Version: 1.3.0\nDownload and install latest update directly online from GitHub Releases."
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Update Server URL:"
        android:textColor="#CBD5E1"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etUpdateUrl"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_edit_text"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:inputType="textUri"
        android:singleLine="true"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="12dp" />

    <ProgressBar
        android:id="@+id/pbUpdateDownload"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:progressTint="#10B981"
        android:progressBackgroundTint="#334155"
        android:visibility="gone"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvUpdateStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#38BDF8"
        android:textSize="12sp"
        android:visibility="gone"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnCancelUpdate"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Cancel"
            android:textColor="#94A3B8"
            android:backgroundTint="#334155"
            app:cornerRadius="22dp"
            android:layout_marginEnd="10dp" />

        <Button
            android:id="@+id/btnStartUpdate"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Download &amp; Install"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:backgroundTint="#059669"
            app:cornerRadius="22dp" />
    </LinearLayout>

</LinearLayout>
